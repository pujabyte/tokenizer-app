{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md", "harness/workflow.md", "harness/memory/LEARNINGS.md", "harness/rules/common/*.md"],
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "environment": { "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}" },
      "enabled": true
    },
    "rtk": { "type": "local", "command": ["rtk-mcp"], "enabled": true }
  }
}
